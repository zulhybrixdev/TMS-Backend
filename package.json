{
  "name": "tms-backend",
  "version": "1.0.0",
  "description": "Treasury Management System - Backend API",
  "main": "dist/index.js",
  "scripts": {
    "dev": "DOTENV_CONFIG_PATH=.env.development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:uat": "DOTENV_CONFIG_PATH=.env node dist/index.js",
    "start:production": "DOTENV_CONFIG_PATH=.env.production node dist/index.js",
    "seed": "DOTENV_CONFIG_PATH=.env.development tsx prisma/seed.ts",
    "seed:uat": "DOTENV_CONFIG_PATH=.env tsx prisma/seed.ts",
    "seed:production": "DOTENV_CONFIG_PATH=.env.production tsx prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "set -a && . ./.env.development && set +a && prisma migrate dev",
    "prisma:deploy": "set -a && . ./.env && set +a && prisma migrate deploy",
    "prisma:deploy:production": "set -a && . ./.env.production && set +a && prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json"
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^7.1.0",
    "jose": "^6.2.12",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "otplib": "^12.0.1",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.16.5",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/yamljs": "^0.2.34",
    "prisma": "^5.20.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
