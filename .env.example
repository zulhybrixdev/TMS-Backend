# Database - native MySQL (brew/local install, default port 3306), no docker
DATABASE_URL="mysql://tms:tms_password@localhost:3306/tms"
# Empty database the `tms` user has full rights on, used only by
# `prisma migrate dev` to diff schema changes (see schema.prisma).
SHADOW_DATABASE_URL="mysql://tms:tms_password@localhost:3306/tms_shadow"

# Server
# Distinctive, uncommon ports on purpose (3000/4000/5000 are common
# defaults likely already in use on a real server). This file (.env) is the
# "uat" tier - both the full app and /poc are served, switchable live via
# Platform Console. Every tier has its own port, database, and env file so
# they can all run at the same time without colliding:
#   2417 = local dev backend, hot-reload (.env.development)
#   3417 = frontend's own Vite dev server (frontend/vite.config.ts)
#   4417 = uat/poc backend (this file)
#   5417 = production backend (.env.production, never serves /poc)
PORT=4417
NODE_ENV=development
CORS_ORIGIN=http://localhost:3417

# Auth
JWT_SECRET="change-this-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=10

# Public URL of the frontend app (used to build Fiuu return/notification
# URLs and the dummy-checkout link). Defaults to CORS_ORIGIN if unset.
APP_URL=http://localhost:3417

# Fiuu payment gateway (subscription billing). Leave both unset to run the
# built-in dummy checkout simulator instead of real Fiuu redirects - see
# backend/src/modules/billing/fiuu-client.ts. Once you have real Fiuu
# sandbox/production credentials, set these and checkout switches over
# automatically, no code changes needed.
FIUU_MERCHANT_ID=
FIUU_VERIFY_KEY=
FIUU_ENVIRONMENT=sandbox

# Twelve Data (https://twelvedata.com) - intraday/live FX rates, separate
# from the always-on Frankfurter daily-reference provider. Leave unset to
# fall back to that daily rate automatically. Free "basic" plan: 8
# credits/min, 800/day - fx.service.ts caches aggressively (10 min TTL)
# specifically to respect this.
TWELVEDATA_API_KEY=

# Deployment tier: "uat" (default, this file) or "production" (see
# .env.production - never mounts /poc). Platform Console is reachable on
# every tier regardless.
DEPLOY_ENV=uat

MFA_ENCRYPTION_KEY=

TIER_LABEL=

# Keycloak SSO broker (optional - see keycloak/ at the repo root)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_REDIRECT_URI=

# Max secret-checking attempts (login/register/MFA/change-password) per IP per 15 min
RATE_LIMIT_AUTH_MAX=

# Keycloak service account used by the Platform Console (see keycloak/provision-platform-client.sh)
KEYCLOAK_ADMIN_CLIENT_ID=
KEYCLOAK_ADMIN_CLIENT_SECRET=
