# Local dev tier - hot-reload backend (tsx watch), its own port/database so
# it can run at the same time as the uat backend without colliding. See
# README §12 / config/env.ts for the full port map:
#   2417 = this file, dev backend (never deployed)
#   3417 = frontend's own Vite dev server (frontend/vite.config.ts)
#   4417 = uat/poc backend (backend/.env)
#   5417 = production backend (backend/.env.production)
DATABASE_URL="mysql://tms:tms_password@localhost:3306/tms_dev"
# Empty database the `tms` user has full rights on, used only by
# `prisma migrate dev` to diff schema changes - kept separate from the uat
# tier's tms_shadow so the two backends' migrate-dev runs never collide.
SHADOW_DATABASE_URL="mysql://tms:tms_password@localhost:3306/tms_dev_shadow"

PORT=2417
NODE_ENV=development
CORS_ORIGIN=http://localhost:3417
APP_URL=http://localhost:3417

JWT_SECRET="dev-secret-change-me-in-production-please"
JWT_EXPIRES_IN="8h"
BCRYPT_SALT_ROUNDS=10

FIUU_MERCHANT_ID=
FIUU_VERIFY_KEY=
FIUU_ENVIRONMENT=sandbox

# Same as uat behaviourally (mounts /poc, Platform Console reachable, no
# module gating differences) - only the port/database/env file differ.
DEPLOY_ENV=uat

# Twelve Data (https://twelvedata.com) - intraday/live FX rates, separate
# from the Frankfurter daily-reference provider (see fx-provider.ts). Free
# "basic" plan: 8 credits/min, 800 credits/day - fx.service.ts caches
# aggressively (10 min TTL) specifically to respect this. Leave unset to
# fall back to the daily Frankfurter rate automatically.
TWELVEDATA_API_KEY=d29ebb6095ff462097ee9cd74866663a

MFA_ENCRYPTION_KEY="BSXEnMVuc4ruT2rja5ldfYgV8JFxVc-bAXH3fgjFzzY"

TIER_LABEL=DEV

# Keycloak SSO broker (dev tier only - see keycloak/ + README SSO section)
KEYCLOAK_URL="http://localhost:8080"
KEYCLOAK_REALM="treasury-system"
KEYCLOAK_CLIENT_ID="tms-backend"
KEYCLOAK_CLIENT_SECRET="5HdEZexouCQ1tO36AqmXt4pjGHtBt9q6"


KEYCLOAK_ADMIN_CLIENT_ID="tms-platform-admin"
KEYCLOAK_ADMIN_CLIENT_SECRET="7h4cPd0aHJu4jdcg1HOp2AJW7mUZLVt2I19eU15dF0ZgXrsCPaLMvVg8fkxvUfcId09cMPV42lDq4FaphyRZeB"
